{
    "name": "@osm/monorepo-root",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "applications/*",
        "services/*",
        "packages/*",
        "libraries/*",
        "scripts/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "lint": "npm run lint --workspaces",
        "test": "npm run test --workspaces",
        "dev:auth": "npm run dev --workspace=services/authentication-service",
        "dev:notify": "npm run dev --workspace=services/notification-service",
        "docker:up": "docker-compose up --build"
    },
    "devDependencies": {
        "typescript": "^5.7.3",
        "prettier": "^3.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0"
    }
}